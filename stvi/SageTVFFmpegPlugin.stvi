      <Value>"Choose the preferred hardware backend and hardware decode policy."</Value>
     </Attribute>
     <FixedWidth>1.0</FixedWidth>
     <FixedHeight>0.125</FixedHeight>
     <Insets>0.012,0.018,0.012,0.018</Insets>
     <HorizontalAlignment>0.0</HorizontalAlignment>
     <Shape Name="Row Separator" Sym="VIBEFFMPEG-CATEGORY-ROW-02-SEPARATOR">
      <ForegroundColor>0xB8B8B8</ForegroundColor>
      <ForegroundAlpha>105</ForegroundAlpha>
      <AnchorX>0.5</AnchorX>
