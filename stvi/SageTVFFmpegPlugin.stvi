   <Panel Name="Buttons" Sym="VIBEFFMPEG-CATEGORY-BUTTONS">
    <Layout>Vertical</Layout>
    <FixedWidth>0.38</FixedWidth>
    <FixedHeight>1.0</FixedHeight>
    <Insets>0.018,0.012,0.012,0.012</Insets>
    <VerticalAlignment>0.0</VerticalAlignment>
    <WrapVNav>true</WrapVNav>
    <Attribute Name="NeedLostCleanup" Sym="VIBEFFMPEG-CATEGORY-CLEANUP">
     <Value>If(NeedLostCleanup==null,false,NeedLostCleanup)</Value>
    </Attribute>
    <Item Name="Playback &amp; Transcoding" Sym="VIBEFFMPEG-CATEGORY-ROW-01">
     <Attribute Name="SetupArea" Sym="VIBEFFMPEG-CATEGORY-ROW-01-002">
      <Value>"xVibeFFmpegCategory1"</Value>
     </Attribute>
     <Attribute Name="AreaName" Sym="VIBEFFMPEG-CATEGORY-ROW-01-003">
      <Value>"Playback &amp; Transcoding"</Value>
     </Attribute>
     <Action ID="912001" Name="&quot;REM Show button name &amp; highlight if section is active but not in focus&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-01-004">
      <Conditional Name="(CurrSetupArea == SetupArea) &amp;&amp; !Focused" Sym="VIBEFFMPEG-CATEGORY-ROW-01-005">
       <Action ID="912002" Name="&quot;REM Show faded out highlight button if this is the current setup area.&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-01-006">
        <Action Name="NeedLostCleanup = true" Sym="VIBEFFMPEG-CATEGORY-ROW-01-007">
         <Action ID="912003" Name="&quot;REM Draw partial button highlight for non-focused normal buttons&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-01-008">
          <Action Name="gButtonHighlight" Sym="VIBEFFMPEG-CATEGORY-ROW-01-009">
           <Image Name="Partial Button Highlight" Sym="VIBEFFMPEG-CATEGORY-ROW-01-010">
            <ForegroundAlpha>0.75</ForegroundAlpha>
            <FixedWidth>1.0</FixedWidth>
            <FixedHeight>1.0</FixedHeight>
            <PreserveAspectRatio>false</PreserveAspectRatio>
            <ResizeImage>true</ResizeImage>
            <AutoRepeatAction>false</AutoRepeatAction>
            <BackgroundComponent>true</BackgroundComponent>
            <ScalingInsets>=gButtonHighlightScalingInsets</ScalingInsets>
            <MouseTransparency>false</MouseTransparency>
            <CropToFill>false</CropToFill>
            <ScaleDiffuse>false</ScaleDiffuse>
            <BGLoad>false</BGLoad>
            <Action ID="912004" Name="&quot;REM Effect to hide the highlight on non-focused items; skip Show effect.&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-01-011">
             <Action Name="Duration = GetProperty(&quot;ui/effect_anims/focus_transition_fx_duration&quot;,150)/2" Sym="VIBEFFMPEG-CATEGORY-ROW-01-012">
              <Action Name="Duration = If( GetProperty(&quot;ui/effect_anims/focus_transition_fx_enabled&quot;,true), Duration, 0 )" Sym="VIBEFFMPEG-CATEGORY-ROW-01-013">
               <Effect Name="Hide Highlight" Sym="VIBEFFMPEG-CATEGORY-ROW-01-014">
                <BackgroundAlpha>0.0</BackgroundAlpha>
                <ForegroundAlpha>0.75</ForegroundAlpha>
                <EffectTrigger>Hidden</EffectTrigger>
                <Duration>=Duration</Duration>
                <Loop>false</Loop>
                <Reversible>false</Reversible>
                <Timescale>Quadratic</Timescale>
                <Easing>Out</Easing>
                <MenuRelativeOffsets>false</MenuRelativeOffsets>
                <Clipped>false</Clipped>
               </Effect>
              </Action>
             </Action>
            </Action>
           </Image>
          </Action>
         </Action>
        </Action>
       </Action>
      </Conditional>
      <Action ID="912005" Name="&quot;REM Display button text&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-01-015">
       <Action Name="AreaName" Sym="VIBEFFMPEG-CATEGORY-ROW-01-016">
        <Text Name="" Sym="VIBEFFMPEG-CATEGORY-ROW-01-017">
         <FixedWidth>1.0</FixedWidth>
         <FixedHeight>1.0</FixedHeight>
         <TextAlignment>0.0</TextAlignment>
