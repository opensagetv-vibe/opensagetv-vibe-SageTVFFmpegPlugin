                    <MouseTransparency>false</MouseTransparency>
                    <Action Name="NumManagedCols = If(NumCols==1,NumColsPerPage,1)" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-005">
                     <Action ID="1618302" Name="&quot;REM Draw the vertical scrolling area background&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-006">
                      <Action Name="gScrollVArea" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-007">
                       <Image Name="Scroll V Area" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-008">
                        <AnchorX>0.5</AnchorX>
                        <AnchorY>0.5</AnchorY>
                        <AnchorPointX>0.5</AnchorPointX>
                        <AnchorPointY>0.5</AnchorPointY>
                        <FixedWidth>0.75</FixedWidth>
                        <FixedHeight>1.0</FixedHeight>
                        <Insets>0,.003,0,.003</Insets>
                        <PreserveAspectRatio>false</PreserveAspectRatio>
                        <ResizeImage>true</ResizeImage>
                        <AutoRepeatAction>true</AutoRepeatAction>
                        <BackgroundComponent>true</BackgroundComponent>
                        <MouseTransparency>false</MouseTransparency>
                        <CropToFill>false</CropToFill>
                        <ScaleDiffuse>false</ScaleDiffuse>
                        <BGLoad>false</BGLoad>
                        <Action Name="&quot;REM If mouse is here, then act on this mouse-activated response.&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-009">
                         <Conditional Name="MouseIsHere" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-010">
                          <Conditional Name="(MouseRelY &gt;= 0.0) &amp;&amp; (MouseRelY &lt;= 1.0) &amp;&amp; (MouseRelX &gt;= 0.0) &amp;&amp; (MouseRelX &lt;= 1.0)" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-011">
                           <Conditional Name="InDragPosMode" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-012">
                            <Branch Name="true" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-013">
                             <Action Name="&quot;REM Scroll to vertical position of mouse action&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-014">
                              <Action Name="y = MouseRelY / If(NumCols==1,NumColsPerPage,1)" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-015">
                               <Action Name="SetScrollPosition( -1.0, y )" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-016" />
                              </Action>
                             </Action>
                            </Branch>
                            <Branch Name="else" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-017">
                             <Action Name="&quot;REM If using wrap-around scrolling &amp; the second marker is shown, determine which marker is closer.&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-018">
                              <Conditional Name="WrapVScroll == true" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-019">
                               <Branch Name="true" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-020">
                                <Conditional Name="size2 &gt; 0" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-021">
                                 <Branch Name="true" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-022">
                                  <Action Name="&quot;REM Using dual wrapped scrollbar markers.&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-023">
                                   <Action Name="dist1 = java_lang_Math_abs( pos - MouseRelY )" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-024">
                                    <Action Name="dist2 = java_lang_Math_abs( MouseRelY - (pos2 + size2) )" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-025">
                                     <Conditional Name="dist1 &gt;= dist2" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-026">
                                      <Branch Name="true" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-027">
                                       <Conditional Name="MouseRelY &gt; pos2 + size2" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-028">
                                        <Action Name="ThisUIContext = GetUIComponentContext()" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-029">
                                         <Action Name="SendEventToUIComponent( ThisUIContext, &quot;Page Down&quot;, 1 )" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-030" />
                                        </Action>
                                       </Conditional>
                                      </Branch>
                                      <Branch Name="else" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-031">
                                       <Conditional Name="MouseRelY &lt; pos" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-032">
                                        <Action Name="ThisUIContext = GetUIComponentContext()" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-033">
                                         <Action Name="SendEventToUIComponent( ThisUIContext, &quot;Page Up&quot;, 1 )" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-034" />
                                        </Action>
                                       </Conditional>
                                      </Branch>
                                     </Conditional>
                                    </Action>
                                   </Action>
                                  </Action>
                                 </Branch>
                                 <Branch Name="else" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-035">
                                  <Action Ref="1618303" Name="&quot;REM Not using dual wr..." />
                                 </Branch>
                                </Conditional>
                               </Branch>
                               <Branch Name="else" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-036">
                                <Action ID="1618303" Name="&quot;REM Not using dual wrapped scrollbar markers.&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-037">
                                 <Conditional Name="MouseRelY &lt; pos" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-038">
                                  <Action Name="ThisUIContext = GetUIComponentContext()" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-039">
                                   <Action Name="SendEventToUIComponent( ThisUIContext, &quot;Page Up&quot;, 1 )" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-040" />
                                  </Action>
                                 </Conditional>
                                 <Conditional Name="MouseRelY &gt; pos + size" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-041">
                                  <Action Name="ThisUIContext = GetUIComponentContext()" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-042">
                                   <Action Name="SendEventToUIComponent( ThisUIContext, &quot;Page Down&quot;, 1 )" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-043" />
                                  </Action>
                                 </Conditional>
                                </Action>
                               </Branch>
                              </Conditional>
                             </Action>
                            </Branch>
                           </Conditional>
                          </Conditional>
                         </Conditional>
                        </Action>
                        <Listener Name="MouseDrag" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-044">
                         <ListenerEvent>MouseDrag</ListenerEvent>
                         <Action Name="&quot;REM Act on mouse drag on this image.&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-045">
                          <Action Ref="1618307" Name="MouseRelY = RelativeY" />
                          <Action Name="&quot;REM If cursor is on top of the scroll position indicator, enter drag position mode.&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-046">
                           <Conditional Name="!InDragPosMode" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-047">
                            <Conditional Name="(MouseRelY &gt;= pos) &amp;&amp; (MouseRelY &lt;= (pos + size)) &amp;&amp; (MouseRelX &gt;= 0.0) &amp;&amp; (MouseRelX &lt;= 1.0)" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-048">
                             <Branch Name="true" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-049">
                              <Action ID="1618304" Name="InDragPosMode = true" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-050" />
                             </Branch>
                             <Branch Name="else" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-051">
                              <Conditional Name="(WrapVScroll == true) &amp;&amp; (size2 &gt; 0)" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-052">
                               <Conditional Name="(MouseRelY &gt;= pos2) &amp;&amp; (MouseRelY &lt;= (pos2 + size2)) &amp;&amp; (MouseRelX &gt;= 0.0) &amp;&amp; (MouseRelX &lt;= 1.0)" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-053">
                                <Action Ref="1618304" Name="InDragPosMode = true" />
                               </Conditional>
                              </Conditional>
                             </Branch>
                            </Conditional>
                           </Conditional>
                          </Action>
                          <Action Name="PassiveListen()" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-054" />
                         </Action>
                        </Listener>
                        <Listener ID="1618305" Name="" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-055">
                         <ListenerEvent>MouseMove</ListenerEvent>
                         <Action Name="MouseIsHere = true" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-056">
                          <Action Ref="1618307" Name="MouseRelY = RelativeY" />
                          <Action Ref="1618309" Name="InDragPosMode = false" />
                          <Action Name="PassiveListen()" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-057" />
                         </Action>
                        </Listener>
                        <Listener ID="1618306" Name="" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-058">
                         <ListenerEvent>MouseEnter</ListenerEvent>
                         <Action Name="MouseIsHere = true" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-059">
                          <Action ID="1618307" Name="MouseRelY = RelativeY" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-060">
                           <Action Name="MouseRelX = RelativeX" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-061" />
                          </Action>
                          <Action Ref="1618309" Name="InDragPosMode = false" />
                          <Action Name="PassiveListen()" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-062" />
                         </Action>
                        </Listener>
                        <Listener ID="1618308" Name="" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-063">
                         <ListenerEvent>MouseExit</ListenerEvent>
                         <Action Name="MouseIsHere = false" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-064">
                          <Action Ref="1618307" Name="MouseRelY = RelativeY" />
                          <Action ID="1618309" Name="InDragPosMode = false" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-065" />
                          <Action Name="PassiveListen()" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-066" />
                         </Action>
                        </Listener>
                        <Attribute ID="1618310" Name="MouseIsHere" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-067">
                         <Value>false</Value>
                        </Attribute>
                        <Attribute ID="1618311" Name="MouseRelY" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-068">
                         <Value>MouseRelY</Value>
                        </Attribute>
                        <Attribute ID="1618312" Name="MouseRelX" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-069">
                         <Value>MouseRelX</Value>
                        </Attribute>
                        <Attribute ID="1618313" Name="InDragPosMode" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-070">
                         <Value>false</Value>
                        </Attribute>
                       </Image>
                      </Action>
                     </Action>
                     <Action Name="&quot;REM Draw the current vertical scroll position marker(s).&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-071">
                      <Conditional Name="WrapVScroll == true" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-072">
                       <Branch Name="true" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-073">
                        <Action Name="&quot;REM If number of items after VScrollIndex &lt; Num Items Per page&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-074" />
                        <Action Name="numwrappedItems = (NumManagedCols*NumRowsPerPage) - (NumRows-((VScrollIndex-1)*NumManagedCols))" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-075">
                         <Conditional Name="numwrappedItems &gt; 0" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-076">
                          <Branch Name="true" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-077">
                           <Action Name="&quot;REM Wrapping! Use 2 scrollbar markers&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-078">
                            <Action Ref="1618315" Name="&quot;REM Draw V scrollbar ..." />
                            <Action Name="&quot;REM Draw V scrollbar part 2, wrapped portion.&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-079">
                             <Action Name="&quot;REM size=remainder items &quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-080" />
                             <Action Name="size2 = Min(NumRowsPerPage*NumManagedCols+0.0001,(numwrappedItems+0.0001)) / (NumRows)" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-081">
                              <Action Name="size2 = Max(0.03,size2)" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-082">
                               <Action Name="pos2 = 0.0" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-083">
                                <Action Name="&quot;REM Draw the vertical scroll bar, part 2&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-084">
                                 <Action Name="gScrollVBar" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-085">
                                  <Image Name="Scroll V Bar" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-086">
                                   <AnchorX>0.5</AnchorX>
                                   <AnchorY>=pos2</AnchorY>
                                   <AnchorPointX>0.5</AnchorPointX>
                                   <AnchorPointY>0.0</AnchorPointY>
                                   <FixedWidth>0.75</FixedWidth>
                                   <FixedHeight>=size2</FixedHeight>
                                   <Insets>0,.003,0,.003</Insets>
                                   <PreserveAspectRatio>false</PreserveAspectRatio>
                                   <ResizeImage>true</ResizeImage>
                                   <AutoRepeatAction>false</AutoRepeatAction>
                                   <BackgroundComponent>false</BackgroundComponent>
                                   <ScalingInsets>=gScrollVBarScalingInsets</ScalingInsets>
                                   <MouseTransparency>true</MouseTransparency>
                                   <CropToFill>false</CropToFill>
                                   <ScaleDiffuse>false</ScaleDiffuse>
                                   <BGLoad>false</BGLoad>
                                  </Image>
                                 </Action>
                                </Action>
                               </Action>
                              </Action>
                             </Action>
                            </Action>
                           </Action>
                          </Branch>
                          <Branch Name="else" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-087">
                           <Action Ref="1618314" Name="&quot;REM Use a single scro..." />
                          </Branch>
                         </Conditional>
                        </Action>
                       </Branch>
                       <Branch Name="else" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-088">
                        <Action ID="1618314" Name="&quot;REM Use a single scroll bar marker.&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-089">
                         <Action Name="size2 = 0" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-090">
                          <Action Name="pos2 = 0.0" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-091">
                           <Action ID="1618315" Name="&quot;REM Draw V scrollbar part 1.&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-092">
                            <Action Name="&quot;REM size=displayed items / total items (Min value 0.01)&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-093">
                             <Action Name="size = Min(NumRowsPerPage*NumManagedCols+0.0001,(NumRows-((VScrollIndex-1)*NumManagedCols)+0.0001)) / (NumRows)" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-094">
                              <Action Name="size = Max(0.03,size)" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-095">
                               <Action Name="pos = ((VScrollIndex-1+0.0001)/((NumRows+0.0001)/NumManagedCols))" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-096">
                                <Action Name="pos = Max(0.0,pos)" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-097">
                                 <Action Name="pos = Min(1.0-size,pos)" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-098">
                                  <Action ID="1618316" Name="&quot;REM Draw the vertical scroll bar&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-099">
                                   <Action Name="gScrollVBar" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-100">
                                    <Image Name="Scroll V Bar" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-101">
                                     <AnchorX>0.5</AnchorX>
                                     <AnchorY>=pos</AnchorY>
                                     <AnchorPointX>0.5</AnchorPointX>
                                     <AnchorPointY>0.0</AnchorPointY>
                                     <FixedWidth>0.75</FixedWidth>
                                     <FixedHeight>=size</FixedHeight>
                                     <Insets>0,.003,0,.003</Insets>
                                     <PreserveAspectRatio>false</PreserveAspectRatio>
                                     <ResizeImage>true</ResizeImage>
                                     <AutoRepeatAction>false</AutoRepeatAction>
                                     <BackgroundComponent>false</BackgroundComponent>
                                     <ScalingInsets>=gScrollVBarScalingInsets</ScalingInsets>
                                     <MouseTransparency>true</MouseTransparency>
                                     <CropToFill>false</CropToFill>
                                     <ScaleDiffuse>false</ScaleDiffuse>
                                     <BGLoad>false</BGLoad>
                                    </Image>
                                   </Action>
                                  </Action>
                                 </Action>
                                </Action>
                               </Action>
                              </Action>
                             </Action>
                            </Action>
                           </Action>
                          </Action>
                         </Action>
                        </Action>
                       </Branch>
                      </Conditional>
                     </Action>
                    </Action>
                   </Panel>
                  </Action>
                 </Conditional>
                </Action>
                <Attribute ID="1620401" Name="pos" Sym="VIBEFFMPEG-CONFIG-PAGINATION-05-5-001">
                 <Value>0</Value>
                </Attribute>
                <Attribute ID="1622501" Name="size" Sym="VIBEFFMPEG-CONFIG-PAGINATION-06-6-001">
                 <Value>0</Value>
                </Attribute>
                <Attribute ID="1624601" Name="pos2" Sym="VIBEFFMPEG-CONFIG-PAGINATION-07-7-001">
                 <Value>0</Value>
                </Attribute>
                <Attribute ID="1626701" Name="size2" Sym="VIBEFFMPEG-CONFIG-PAGINATION-08-8-001">
                 <Value>0</Value>
                </Attribute>
               </Panel>
              </Conditional>
             </Table>
            </Action>
           </Action>
          </Action>
         </Panel>
         <Layout>Vertical</Layout>
         <FixedWidth>1.0</FixedWidth>
         <FixedHeight>1.0</FixedHeight>
         <HorizontalAlignment>0.0</HorizontalAlignment>
         <VerticalAlignment>0.0</VerticalAlignment>
        </Panel>
       </Branch>
      </Conditional>
     </Branch>
    </Conditional>
   </Panel>
  </Panel>
  <Panel Name="Detailed Setup Footer" Sym="VIBEFFMPEG-DETAILED-FOOTER">
   <AnchorX>0.03</AnchorX>
   <AnchorY>0.86</AnchorY>
   <AnchorPointX>0.0</AnchorPointX>
   <AnchorPointY>0.0</AnchorPointY>
   <FixedWidth>0.94</FixedWidth>
