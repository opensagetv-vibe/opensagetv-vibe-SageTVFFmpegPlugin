   <Action Name="&quot;OpenSageTV Vibe FFmpeg Plugin&quot;" Sym="VIBEFFMPEG-DETAILED-HEADER-TITLE-VALUE">
    <Text Name="" Sym="VIBEFFMPEG-DETAILED-HEADER-TITLE">
