                    <Action Name="&quot;REM Get new password.&quot;" Sym="VIBEFFMPEG-CONFIG-144">
                     <Action Name="CurPWD = GetPluginConfigValue(Plugin, Setting)" Sym="VIBEFFMPEG-CONFIG-145">
                      <Conditional Name="Size(CurPWD) &gt; 0" Sym="VIBEFFMPEG-CONFIG-146">
                       <Branch Name="true" Sym="VIBEFFMPEG-CONFIG-147">
                        <Action Name="&quot;REM Already have a password, so check current pwd before accepting a new one.&quot;" Sym="VIBEFFMPEG-CONFIG-148">
