                    <Conditional ID="980081" Name="Focused" Sym="VIBEFFMPEG-CONFIG-EDITOR-4-FOCUS-001">
                     <Branch ID="980082" Name="true" Sym="VIBEFFMPEG-CONFIG-EDITOR-4-FOCUS-002">
                      <Action ID="980083" Name="&quot;REM Draw the normal button highlight image&quot;" Sym="VIBEFFMPEG-CONFIG-EDITOR-4-FOCUS-003">
                       <Action Name="gButtonHighlight" Sym="VIBEFFMPEG-CONFIG-EDITOR-4-FOCUS-004">
