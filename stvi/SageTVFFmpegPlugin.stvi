    <FixedWidth>1.0</FixedWidth>
    <FixedHeight>0.004</FixedHeight>
    <ShapeType>Rectangle</ShapeType>
    <ShapeFill>true</ShapeFill>
    <BackgroundComponent>true</BackgroundComponent>
   </Shape>
   <Action Name="If((CurrSetupArea == null || CurrSetupArea == &quot;xVibeFFmpegCategory1&quot;), &quot;Configure normal playback, transcoding, audio, captions, and seek behavior.&quot;, If(CurrSetupArea == &quot;xVibeFFmpegCategory2&quot;, &quot;Choose the preferred hardware backend and hardware decode policy.&quot;, If(CurrSetupArea == &quot;xVibeFFmpegCategory3&quot;, &quot;Run, export, and review the hardware-acceleration test for this server.&quot;, If(CurrSetupArea == &quot;xVibeFFmpegCategory4&quot;, &quot;Review the active MIM runtime, latest transcode, and available hardware.&quot;, If(CurrSetupArea == &quot;xVibeFFmpegCategory5&quot;, &quot;Configure diagnostics or repair and reload the FFmpeg runtime.&quot;, &quot;Configure normal playback, transcoding, audio, captions, and seek behavior.&quot;)))))" Sym="VIBEFFMPEG-DETAILED-FOOTER-HELP-VALUE">
    <Text Name="" Sym="VIBEFFMPEG-DETAILED-FOOTER-HELP">
     <Insets>0.025,0.01,0.025,0.01</Insets>
     <FixedWidth>1.0</FixedWidth>
     <FixedHeight>1.0</FixedHeight>
     <TextAlignment>0.5</TextAlignment>
     <VerticalAlignment>0.5</VerticalAlignment>
     <Wrap>true</Wrap>
     <FontSize>20</FontSize>
     <ForegroundColor>0xFFFFFF</ForegroundColor>
     <ForegroundSelectedColor>0xFFFFFF</ForegroundSelectedColor>
     <ForegroundAlpha>255</ForegroundAlpha>
    </Text>
   </Action>
  </Panel>
