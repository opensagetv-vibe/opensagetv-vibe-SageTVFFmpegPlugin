     </Shape>
     <Conditional ID="913041" Name="Focused" Sym="VIBEFFMPEG-CATEGORY-ROW-02-FOCUS-001">
      <Branch ID="913042" Name="true" Sym="VIBEFFMPEG-CATEGORY-ROW-02-FOCUS-002">
       <Action ID="913043" Name="&quot;REM Draw the normal button highlight image&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-02-FOCUS-003">
        <Action Name="gButtonHighlight" Sym="VIBEFFMPEG-CATEGORY-ROW-02-FOCUS-004">
