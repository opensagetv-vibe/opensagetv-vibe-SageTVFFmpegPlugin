      <Branch ID="912044" Name="Focused" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-006">
       <Action ID="912045" Name="&quot;REM Draw the button BG -- dividers around items.&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-007">
        <Action Name="gButtonDividerImage" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-008">
         <Image Name="Button Divider image Top" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-009">
          <ForegroundAlpha>=gButtonDividerAlpha/255.0</ForegroundAlpha>
          <AnchorX>0.5</AnchorX>
          <AnchorY>0.0</AnchorY>
          <AnchorPointX>0.5</AnchorPointX>
          <AnchorPointY>0.0</AnchorPointY>
          <FixedWidth>0.85</FixedWidth>
          <FixedHeight>2</FixedHeight>
          <PreserveAspectRatio>false</PreserveAspectRatio>
          <ResizeImage>true</ResizeImage>
          <AutoRepeatAction>false</AutoRepeatAction>
          <BackgroundComponent>true</BackgroundComponent>
          <MouseTransparency>false</MouseTransparency>
          <CropToFill>false</CropToFill>
          <ScaleDiffuse>false</ScaleDiffuse>
          <BGLoad>false</BGLoad>
         </Image>
        </Action>
        <Action Name="gButtonDividerImage" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-010">
         <Image Name="Button Divider image Bottom" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-011">
          <ForegroundAlpha>=gButtonDividerAlpha/255.0</ForegroundAlpha>
          <AnchorX>0.5</AnchorX>
          <AnchorY>1.0</AnchorY>
          <AnchorPointX>0.5</AnchorPointX>
          <AnchorPointY>1.0</AnchorPointY>
          <FixedWidth>0.85</FixedWidth>
          <FixedHeight>2</FixedHeight>
          <PreserveAspectRatio>false</PreserveAspectRatio>
          <ResizeImage>true</ResizeImage>
          <AutoRepeatAction>false</AutoRepeatAction>
          <BackgroundComponent>true</BackgroundComponent>
          <MouseTransparency>false</MouseTransparency>
          <CropToFill>false</CropToFill>
          <ScaleDiffuse>false</ScaleDiffuse>
          <BGLoad>false</BGLoad>
         </Image>
        </Action>
       </Action>
      </Branch>
     </Conditional>
     <Hook ID="912071" Name="FocusGained" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-HOOK-001">
      <Action Name="OldSetupArea = CurrSetupArea" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-HOOK-002">
       <Conditional Name="true" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-HOOK-003">
        <Branch Name="((OldSetupArea == &quot;xCommand Link&quot;) || (OldSetupArea == &quot;xCommand Test&quot;) || (OldSetupArea == &quot;xCommand Unlink&quot;))" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-HOOK-004">
         <Action Name="OldSetupArea = &quot;xCommands&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-HOOK-005" />
        </Branch>
        <Branch Name="OldSetupArea == &quot;xDScaler&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-HOOK-006">
         <Action Name="OldSetupArea = &quot;xVideo&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-HOOK-007" />
        </Branch>
       </Conditional>
       <Action Name="AddGlobalContext(&quot;CurrSetupArea&quot;, &quot;xVibeFFmpegCategory1&quot;)" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-HOOK-008">
        <Conditional Name="NeedLostCleanup" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-HOOK-009">
         <Action Name="NeedLostCleanup = false" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-HOOK-010" />
         <Conditional Name="SetupArea != OldSetupArea" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-HOOK-011">
          <Action Name="RefreshAreaForVariable(&quot;SetupArea&quot;, OldSetupArea)" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-HOOK-012" />
         </Conditional>
        </Conditional>
        <Conditional Name="OldSetupArea != &quot;xVibeFFmpegCategory1&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-CHANGED">
         <Action Name="Refresh()" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-REFRESH" />
        </Conditional>
       </Action>
      </Action>
     </Hook>
     <Action Name="AddGlobalContext(&quot;CurrSetupArea&quot;, &quot;xVibeFFmpegCategory1&quot;)" Sym="VIBEFFMPEG-CATEGORY-ROW-01-ACTIVATE">
      <Action Name="Refresh()" Sym="VIBEFFMPEG-CATEGORY-ROW-01-ACTIVATE-REFRESH" />
     </Action>
    </Item>
    <Item Name="Hardware Setup" Sym="VIBEFFMPEG-CATEGORY-ROW-02">
     <Attribute Name="SetupArea" Sym="VIBEFFMPEG-CATEGORY-ROW-02-002">
