                              <AnchorY>0.0</AnchorY>
                              <AnchorPointX>0.5</AnchorPointX>
                              <FixedWidth>0.85</FixedWidth>
                              <FixedHeight>0.06</FixedHeight>
                              <PreserveAspectRatio>true</PreserveAspectRatio>
                              <ResizeImage>true</ResizeImage>
