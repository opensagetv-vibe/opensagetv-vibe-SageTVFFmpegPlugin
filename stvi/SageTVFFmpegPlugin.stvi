     </Attribute>
     <Action ID="916001" Name="&quot;REM Show button name &amp; highlight if section is active but not in focus&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-05-004">
      <Conditional Name="(CurrSetupArea == SetupArea) &amp;&amp; !Focused" Sym="VIBEFFMPEG-CATEGORY-ROW-05-005">
       <Action ID="916002" Name="&quot;REM Show faded out highlight button if this is the current setup area.&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-05-006">
        <Action Name="NeedLostCleanup = true" Sym="VIBEFFMPEG-CATEGORY-ROW-05-007">
         <Action ID="916003" Name="&quot;REM Draw partial button highlight for non-focused normal buttons&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-05-008">
          <Action Name="gButtonHighlight" Sym="VIBEFFMPEG-CATEGORY-ROW-05-009">
           <Image Name="Partial Button Highlight" Sym="VIBEFFMPEG-CATEGORY-ROW-05-010">
            <ForegroundAlpha>0.75</ForegroundAlpha>
            <FixedWidth>1.0</FixedWidth>
            <FixedHeight>1.0</FixedHeight>
            <PreserveAspectRatio>false</PreserveAspectRatio>
            <ResizeImage>true</ResizeImage>
            <AutoRepeatAction>false</AutoRepeatAction>
            <BackgroundComponent>true</BackgroundComponent>
            <ScalingInsets>=gButtonHighlightScalingInsets</ScalingInsets>
            <MouseTransparency>false</MouseTransparency>
            <CropToFill>false</CropToFill>
            <ScaleDiffuse>false</ScaleDiffuse>
            <BGLoad>false</BGLoad>
            <Action ID="916004" Name="&quot;REM Effect to hide the highlight on non-focused items; skip Show effect.&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-05-011">
             <Action Name="Duration = GetProperty(&quot;ui/effect_anims/focus_transition_fx_duration&quot;,150)/2" Sym="VIBEFFMPEG-CATEGORY-ROW-05-012">
              <Action Name="Duration = If( GetProperty(&quot;ui/effect_anims/focus_transition_fx_enabled&quot;,true), Duration, 0 )" Sym="VIBEFFMPEG-CATEGORY-ROW-05-013">
               <Effect Name="Hide Highlight" Sym="VIBEFFMPEG-CATEGORY-ROW-05-014">
                <BackgroundAlpha>0.0</BackgroundAlpha>
                <ForegroundAlpha>0.75</ForegroundAlpha>
                <EffectTrigger>Hidden</EffectTrigger>
                <Duration>=Duration</Duration>
                <Loop>false</Loop>
                <Reversible>false</Reversible>
                <Timescale>Quadratic</Timescale>
                <Easing>Out</Easing>
                <MenuRelativeOffsets>false</MenuRelativeOffsets>
                <Clipped>false</Clipped>
               </Effect>
              </Action>
             </Action>
            </Action>
           </Image>
          </Action>
         </Action>
        </Action>
       </Action>
      </Conditional>
