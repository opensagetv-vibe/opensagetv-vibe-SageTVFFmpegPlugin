                         <Action ID="1544101" Name="&quot;REM Draw the table's Up arrow.&quot;" Sym="VIBEFFMPEG-CONFIG-0-CHOICE-2-PAGINATION-02-2-001">
                          <Conditional Name="!IsFirstVPage" Sym="VIBEFFMPEG-CONFIG-0-CHOICE-2-PAGINATION-02-2-002">
