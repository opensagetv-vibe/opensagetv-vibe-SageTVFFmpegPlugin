                            <Conditional Name="NumRows &gt; (If(NumCols==1,NumColsPerPage,1)*NumRowsPerPage)" Sym="VIBEFFMPEG-CONFIG-0-CHOICE-2-PAGINATION-03-3-009">
                             <Action ID="1546203" Name="gScrollVDown" Sym="VIBEFFMPEG-CONFIG-0-CHOICE-2-PAGINATION-03-3-010">
                              <Image Name="PageDown disabled" Sym="VIBEFFMPEG-CONFIG-0-CHOICE-2-PAGINATION-03-3-011">
