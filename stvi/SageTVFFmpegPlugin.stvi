                               <Action Name="SendEventToUIComponent( ThisUIContext, &quot;Scroll Up&quot;, 1 )" Sym="VIBEFFMPEG-CONFIG-0-CHOICE-2-PAGINATION-02-2-007" />
                              </Action>
                             </Image>
                            </Action>
                           </Branch>
                           <Branch Name="else" Sym="VIBEFFMPEG-CONFIG-0-CHOICE-2-PAGINATION-02-2-008">
                            <Conditional Name="NumRows &gt; (If(NumCols==1,NumColsPerPage,1)*NumRowsPerPage)" Sym="VIBEFFMPEG-CONFIG-0-CHOICE-2-PAGINATION-02-2-009">
                             <Action ID="1544103" Name="gScrollVUp" Sym="VIBEFFMPEG-CONFIG-0-CHOICE-2-PAGINATION-02-2-010">
