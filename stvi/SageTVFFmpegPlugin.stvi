       <Action ID="912043" Name="&quot;REM Draw the normal button highlight image&quot;" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-003">
        <Action Name="gButtonHighlight" Sym="VIBEFFMPEG-CATEGORY-ROW-01-FOCUS-004">
