                    <Conditional ID="980101" Name="Focused" Sym="VIBEFFMPEG-CONFIG-EDITOR-5-FOCUS-001">
                     <Branch ID="980102" Name="true" Sym="VIBEFFMPEG-CONFIG-EDITOR-5-FOCUS-002">
                      <Action ID="980103" Name="&quot;REM Draw the normal button highlight image&quot;" Sym="VIBEFFMPEG-CONFIG-EDITOR-5-FOCUS-003">
                       <Action Name="gButtonHighlight" Sym="VIBEFFMPEG-CONFIG-EDITOR-5-FOCUS-004">
                        <Image Name="Button Highlight" Sym="VIBEFFMPEG-CONFIG-EDITOR-5-FOCUS-005">
                         <FixedWidth>1.0</FixedWidth>
                         <FixedHeight>1.0</FixedHeight>
                         <PreserveAspectRatio>false</PreserveAspectRatio>
                         <ResizeImage>true</ResizeImage>
                         <AutoRepeatAction>false</AutoRepeatAction>
