                         <Action ID="1524101" Name="&quot;REM Draw the table's Up arrow.&quot;" Sym="VIBEFFMPEG-CONFIG-0-CHOICE-1-PAGINATION-02-2-001">
                          <Conditional Name="!IsFirstVPage" Sym="VIBEFFMPEG-CONFIG-0-CHOICE-1-PAGINATION-02-2-002">
                           <Branch ID="1524102" Name="true" Sym="VIBEFFMPEG-CONFIG-0-CHOICE-1-PAGINATION-02-2-003">
                            <Action Name="gScrollVUp" Sym="VIBEFFMPEG-CONFIG-0-CHOICE-1-PAGINATION-02-2-004">
