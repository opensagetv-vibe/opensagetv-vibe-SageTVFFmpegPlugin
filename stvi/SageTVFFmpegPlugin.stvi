  <Panel Name="MenuContainer" Sym="VIBEFFMPEG-CATEGORY-CONTAINER">
   <Layout>Horizontal</Layout>
   <AnchorX>0.03</AnchorX>
   <AnchorY>0.09</AnchorY>
   <AnchorPointX>0.0</AnchorPointX>
   <AnchorPointY>0.0</AnchorPointY>
   <FixedWidth>0.94</FixedWidth>
   <FixedHeight>0.77</FixedHeight>
   <HorizontalAlignment>0.0</HorizontalAlignment>
   <VerticalAlignment>0.0</VerticalAlignment>
   <Shape Name="Background" Sym="VIBEFFMPEG-DETAILED-CONTENT-BACKGROUND">
    <ForegroundColor>0x242424</ForegroundColor>
