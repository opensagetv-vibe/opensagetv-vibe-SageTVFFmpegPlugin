                <Action ID="1618301" Name="&quot;REM Draw the table's Vertical scroll bar content area.&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-001">
                 <Conditional Name="NumRows &gt; (If(NumCols==1,NumColsPerPage,1)*NumRowsPerPage)" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-002">
                  <Action Name="&quot;REM Draw VScrollbar BG &amp; scroll position&quot;" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-003">
                   <Panel Name="Vertical Scroll bar area" Sym="VIBEFFMPEG-CONFIG-PAGINATION-04-4-004">
                    <AnchorX>0.5</AnchorX>
